datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  COMMISSIONER
  SUB_ADMIN
  ADMIN
  COLLECTOR
  USER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  ONLINE
  CASH
  CHEQUE
}

enum WasteRequestStatus {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  MISSED_PICKUP
  BILLING_DISCREPANCY
  DAMAGED_BIN
  GENERAL_INQUIRY
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  role                  Role           @default(COLLECTOR)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  collections           Collection[]
  wasteRequestsCreated  WasteRequest[] @relation("CitizenWasteRequests")
  wasteRequestsAssigned WasteRequest[] @relation("CollectorWasteRequests")
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
}

model PropertyType {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pricingConfigs PricingConfig[]
  properties     Property[]
  wasteRequests  WasteRequest[]
}

model PricingConfig {
  id             String       @id @default(uuid())
  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)
  price          Decimal      @db.Decimal(10, 2)
  unit           String       @default("per_collection")
  isActive       Boolean      @default(true)
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  collections    Collection[]

  @@index([propertyTypeId, isActive])
}

model Property {
  id             String         @id @default(uuid())
  ownerName      String
  address        String
  propertyTypeId String
  propertyType   PropertyType   @relation(fields: [propertyTypeId], references: [id])
  phone          String?
  latitude       Float
  longitude      Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  collections    Collection[]
  wasteRequests  WasteRequest[]

  @@index([propertyTypeId])
  @@index([latitude, longitude])
}

model Collection {
  id               String        @id @default(uuid())
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id])
  collectorId      String
  collector        User          @relation(fields: [collectorId], references: [id])
  pricingConfigId  String
  pricingConfig    PricingConfig @relation(fields: [pricingConfigId], references: [id])
  amountCharged    Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(ONLINE)
  paymentReference String?
  notes            String?
  latitude         Float
  longitude        Float
  collectedAt      DateTime      @default(now())

  @@index([collectedAt])
  @@index([propertyId])
  @@index([collectorId])
  @@index([paymentStatus])
}

model WasteRequest {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation("CitizenWasteRequests", fields: [userId], references: [id])
  propertyId     String?
  property       Property?          @relation(fields: [propertyId], references: [id])
  propertyTypeId String
  propertyType   PropertyType       @relation(fields: [propertyTypeId], references: [id])
  address        String
  latitude       Float?
  longitude      Float?
  wasteType      String             @default("General")
  preferredDate  DateTime
  status         WasteRequestStatus @default(PENDING)
  collectorId    String?
  collector      User?              @relation("CollectorWasteRequests", fields: [collectorId], references: [id])
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportTicket {
  id                String         @id @default(uuid())
  userId            String?
  user              User?          @relation(fields: [userId], references: [id])
  name              String
  email             String
  phone             String?
  category          TicketCategory @default(GENERAL_INQUIRY)
  subject           String
  description       String
  status            TicketStatus   @default(OPEN)
  adminNotes        String?
  freshdeskTicketId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([email])
  @@index([status])
}

model PaymentOrder {
  id                String   @id @default(uuid())
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR")
  status            String   @default("CREATED")
  userId            String?
  collectionId      String?
  wasteRequestId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  userName  String?
  role      Role?
  action    String
  entity    String
  entityId  String?
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([entity])
}
